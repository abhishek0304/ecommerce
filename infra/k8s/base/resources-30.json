{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "redis",
        "namespace": "ecommerce",
        "labels": {
          "app": "redis"
        }
      },
      "spec": {
        "selector": {
          "app": "redis"
        },
        "ports": [
          {
            "name": "p6379",
            "port": 6379,
            "targetPort": 6379
          }
        ]
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "namespace-ingress",
        "namespace": "ecommerce",
        "labels": {
          "app": "namespace-ingress"
        }
      },
      "spec": {
        "podSelector": {},
        "policyTypes": [
          "Ingress"
        ],
        "ingress": [
          {
            "from": [
              {
                "podSelector": {}
              }
            ]
          }
        ]
      }
    }
  ]
}
