                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8085
                  },
                  {
                    "name": "management",
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9090
                  },
                  "failureThreshold": 60,
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9090
                  },
                  "periodSeconds": 20
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 9090
                  },
                  "periodSeconds": 10
                }
              }
            ]
          }
        }
      }
