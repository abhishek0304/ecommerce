{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "cart-service",
        "namespace": "ecommerce",
        "labels": {
          "app": "cart-service"
        }
      },
      "spec": {
        "selector": {
          "app": "cart-service"
        },
        "ports": [
          {
            "name": "p8084",
            "port": 8084,
            "targetPort": 8084
          },
          {
            "name": "p9090",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "order-service",
        "namespace": "ecommerce",
        "labels": {
          "app": "order-service"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "order-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "order-service"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 10001
            },
            "volumes": [],
            "containers": [
              {
                "name": "order-service",
                "image": "ecommerce/order-service:local",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "env": [
                  {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "container"
                  },
                  {
                    "name": "KAFKA_BOOTSTRAP_SERVERS",
                    "value": "kafka:19092"
                  },
                  {
                    "name": "JWT_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "JWT_SECRET"
                      }
                    }
                  },
                  {
                    "name": "INTERNAL_SERVICE_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "INTERNAL_SERVICE_KEY"
                      }
                    }
                  },
                  {
                    "name": "PRODUCT_SERVICE_URL",
                    "value": "http://product-service:8083"
                  },
                  {
                    "name": "CART_SERVICE_URL",
                    "value": "http://cart-service:8084"
                  },
                  {
                    "name": "USER_SERVICE_URL",
                    "value": "http://user-service:8082"
                  },
                  {
                    "name": "RAZORPAY_KEY_ID",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "RAZORPAY_KEY_ID"
                      }
                    }
                  },
                  {
                    "name": "RAZORPAY_KEY_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "RAZORPAY_KEY_SECRET"
                      }
                    }
                  },
                  {
                    "name": "RAZORPAY_WEBHOOK_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "RAZORPAY_WEBHOOK_SECRET"
                      }
                    }
                  },
                  {
                    "name": "SPRING_DATASOURCE_URL",
                    "value": "jdbc:mysql://order-db:3306/orderdb"
                  },
                  {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "value": "order"
                  },
                  {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "ORDER_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SPRING_CLOUD_CONFIG_ENABLED",
