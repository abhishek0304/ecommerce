                    }
                  },
                  {
                    "name": "SHIPPING_WAREHOUSE_NAME",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "SHIPPING_WAREHOUSE_NAME",
