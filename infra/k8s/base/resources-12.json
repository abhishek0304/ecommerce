    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "notification-service",
        "namespace": "ecommerce",
        "labels": {
          "app": "notification-service"
        }
      },
      "spec": {
        "selector": {
          "app": "notification-service"
        },
        "ports": [
