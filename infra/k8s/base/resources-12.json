    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "user-db",
        "namespace": "ecommerce",
        "labels": {
          "app": "user-db"
        }
      },
      "spec": {
        "replicas": 1,
        "serviceName": "user-db",
        "selector": {
          "matchLabels": {
            "app": "user-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "user-db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "user-db",
                "image": "mysql:8.4.4",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "env": [
                  {
                    "name": "MYSQL_DATABASE",
                    "value": "userdb"
                  },
                  {
                    "name": "MYSQL_USER",
                    "value": "user"
                  },
                  {
                    "name": "MYSQL_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "USER_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "MYSQL_ROOT_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "USER_DB_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 3306
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/mysql"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "MYSQL_PWD=\"$MYSQL_PASSWORD\" mysql -h 127.0.0.1 -u\"$MYSQL_USER\" \"$MYSQL_DATABASE\" -e \"SELECT 1\""
                    ]
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10
                }
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "5Gi"
                }
              }
            }
          }
        ]
      }
    }
  ]
