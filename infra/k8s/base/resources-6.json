                        "key": "PRODUCT_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SPRING_CLOUD_CONFIG_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "CONFIG_SERVER_IMPORT",
                    "value": "classpath:/application-container.properties"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8083
                  },
                  {
                    "name": "management",
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
