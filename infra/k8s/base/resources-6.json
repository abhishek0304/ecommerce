{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "api-gateway",
        "namespace": "ecommerce",
        "labels": {
          "app": "api-gateway"
        }
      },
      "spec": {
        "selector": {
          "app": "api-gateway"
        },
        "ports": [
          {
            "name": "p8081",
            "port": 8081,
            "targetPort": 8081
          },
          {
            "name": "p9090",
            "port": 9090,
            "targetPort": 9090
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "user-service",
        "namespace": "ecommerce",
        "labels": {
          "app": "user-service"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "user-service"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "user-service"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 10001
            },
            "volumes": [],
            "containers": [
              {
                "name": "user-service",
                "image": "ecommerce/user-service:local",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "env": [
                  {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "container"
                  },
                  {
                    "name": "KAFKA_BOOTSTRAP_SERVERS",
                    "value": "kafka:19092"
                  },
                  {
                    "name": "JWT_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "JWT_SECRET"
                      }
                    }
                  },
                  {
                    "name": "INTERNAL_SERVICE_KEY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "INTERNAL_SERVICE_KEY"
                      }
                    }
                  },
                  {
                    "name": "PRODUCT_SERVICE_URL",
                    "value": "http://product-service:8083"
                  },
                  {
                    "name": "CART_SERVICE_URL",
                    "value": "http://cart-service:8084"
                  },
                  {
                    "name": "USER_SERVICE_URL",
                    "value": "http://user-service:8082"
                  },
                  {
                    "name": "SPRING_DATASOURCE_URL",
                    "value": "jdbc:mysql://user-db:3306/userdb"
                  },
                  {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "value": "user"
                  },
                  {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "USER_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "SPRING_CLOUD_CONFIG_ENABLED",
                    "value": "false"
                  },
                  {
                    "name": "CONFIG_SERVER_IMPORT",
                    "value": "classpath:/application-container.properties"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8082
                  },
                  {
                    "name": "management",
                    "containerPort": 9090
                  }
                ],
                "volumeMounts": [],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 10001,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9090
                  },
                  "failureThreshold": 60,
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/liveness",
                    "port": 9090
                  },
                  "periodSeconds": 20
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/actuator/health/readiness",
                    "port": 9090
                  },
                  "periodSeconds": 10
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
