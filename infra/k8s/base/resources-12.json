                      }
                    }
                  },
                  {
                    "name": "SHIPPING_WAREHOUSE_PHONE",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "SHIPPING_WAREHOUSE_PHONE",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "SHIPPING_WAREHOUSE_EMAIL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "SHIPPING_WAREHOUSE_EMAIL",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "SHIPPING_WAREHOUSE_ADDRESS",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "SHIPPING_WAREHOUSE_ADDRESS",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "SHIPPING_WAREHOUSE_CITY",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "SHIPPING_WAREHOUSE_CITY",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "SHIPPING_WAREHOUSE_STATE",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "SHIPPING_WAREHOUSE_STATE",
