{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "order-db",
        "namespace": "ecommerce",
        "labels": {
          "app": "order-db"
        }
      },
      "spec": {
        "clusterIP": "None",
        "selector": {
          "app": "order-db"
        },
        "ports": [
          {
            "name": "p3306",
            "port": 3306,
            "targetPort": 3306
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "notification-db",
        "namespace": "ecommerce",
        "labels": {
          "app": "notification-db"
        }
      },
      "spec": {
        "replicas": 1,
        "serviceName": "notification-db",
        "selector": {
          "matchLabels": {
            "app": "notification-db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "notification-db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "notification-db",
                "image": "mysql:8.4.4",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "env": [
                  {
                    "name": "MYSQL_DATABASE",
                    "value": "notificationdb"
                  },
                  {
                    "name": "MYSQL_USER",
                    "value": "notification"
                  },
                  {
                    "name": "MYSQL_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "NOTIFICATION_DB_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "MYSQL_ROOT_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "NOTIFICATION_DB_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 3306
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/mysql"
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "MYSQL_PWD=\"$MYSQL_PASSWORD\" mysql -h 127.0.0.1 -u\"$MYSQL_USER\" \"$MYSQL_DATABASE\" -e \"SELECT 1\""
                    ]
                  },
                  "initialDelaySeconds": 30,
                  "periodSeconds": 10
                }
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "5Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "notification-db",
        "namespace": "ecommerce",
        "labels": {
          "app": "notification-db"
        }
      },
      "spec": {
        "clusterIP": "None",
        "selector": {
          "app": "notification-db"
        },
        "ports": [
          {
            "name": "p3306",
            "port": 3306,
            "targetPort": 3306
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "kafka",
        "namespace": "ecommerce",
        "labels": {
          "app": "kafka"
        }
      },
      "spec": {
        "replicas": 1,
        "serviceName": "kafka",
        "selector": {
          "matchLabels": {
            "app": "kafka"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "kafka"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "securityContext": {
              "fsGroup": 1000
            },
            "containers": [
              {
                "name": "kafka",
                "image": "apache/kafka:3.9.1",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "250m",
                    "memory": "512Mi"
                  },
                  "limits": {
                    "cpu": "2",
                    "memory": "1Gi"
                  }
                },
                "env": [
                  {
                    "name": "KAFKA_NODE_ID",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_PROCESS_ROLES",
                    "value": "broker,controller"
                  },
                  {
                    "name": "KAFKA_LISTENERS",
                    "value": "PLAINTEXT://:19092,EXTERNAL://:9092,CONTROLLER://:9093"
                  },
                  {
                    "name": "KAFKA_ADVERTISED_LISTENERS",
                    "value": "PLAINTEXT://kafka:19092,EXTERNAL://kafka:9092"
                  },
                  {
                    "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
                    "value": "CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT,EXTERNAL:PLAINTEXT"
                  },
                  {
                    "name": "KAFKA_INTER_BROKER_LISTENER_NAME",
                    "value": "PLAINTEXT"
                  },
                  {
                    "name": "KAFKA_CONTROLLER_LISTENER_NAMES",
                    "value": "CONTROLLER"
                  },
                  {
                    "name": "KAFKA_CONTROLLER_QUORUM_VOTERS",
                    "value": "1@kafka:9093"
                  },
                  {
                    "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_TRANSACTION_STATE_LOG_MIN_ISR",
                    "value": "1"
                  },
                  {
                    "name": "KAFKA_LOG_DIRS",
                    "value": "/tmp/kraft-combined-logs"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 19092
                  },
                  {
                    "containerPort": 9093
                  }
                ],
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/tmp/kraft-combined-logs"
                  }
                ]
              }
            ]
          }
        },
        "volumeClaimTemplates": [
          {
            "metadata": {
              "name": "data"
            },
            "spec": {
              "accessModes": [
                "ReadWriteOnce"
              ],
              "resources": {
                "requests": {
                  "storage": "5Gi"
                }
              }
            }
          }
        ]
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "kafka",
        "namespace": "ecommerce",
        "labels": {
          "app": "kafka"
        }
      },
      "spec": {
        "clusterIP": "None",
        "selector": {
          "app": "kafka"
        },
        "ports": [
          {
            "name": "p19092",
            "port": 19092,
            "targetPort": 19092
          },
          {
            "name": "p9093",
            "port": 9093,
            "targetPort": 9093
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "redis",
        "namespace": "ecommerce",
        "labels": {
          "app": "redis"
        }
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app": "redis"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "redis"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "name": "redis",
                "image": "redis:7.4.2-alpine",
                "imagePullPolicy": "IfNotPresent",
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "1",
                    "memory": "768Mi"
                  }
                },
                "command": [
                  "sh",
                  "-c",
                  "exec redis-server --requirepass \"$REDIS_PASSWORD\" --maxmemory 128mb --maxmemory-policy allkeys-lru"
                ],
                "env": [
                  {
                    "name": "REDIS_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-secrets",
                        "key": "REDIS_PASSWORD"
                      }
                    }
                  }
                ],
                "ports": [
                  {
                    "containerPort": 6379
                  }
                ],
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "redis-cli -a \"$REDIS_PASSWORD\" ping | grep -q PONG"
                    ]
                  },
                  "periodSeconds": 10
                },
                "volumeMounts": []
              }
            ],
            "volumes": []
          }
        }
      }
    }
  ]
}
