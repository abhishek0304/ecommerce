                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "DELHIVERY_PICKUP_LOCATION",
                        "optional": true
                      }
                    }
                  },
                  {
                    "name": "DELHIVERY_CLIENT_NAME",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "ecommerce-shipping-providers",
                        "key": "DELHIVERY_CLIENT_NAME",
